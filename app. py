
import json
import os
import urllib.request
import urllib.error
from pathlib import Path

from fastapi import FastAPI
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel

app = FastAPI(title="BuildMaster AI", version="1.2.0")

BASE_DIR = Path(__file__).resolve().parent
STATIC_DIR = BASE_DIR / "static"
preferences = []

if STATIC_DIR.exists():
    app.mount("/static", StaticFiles(directory=str(STATIC_DIR)), name="static")


class ChatRequest(BaseModel):
    message: str


class MemoryRequest(BaseModel):
    preferences: list[str]


@app.get("/")
def home():
    index_file = STATIC_DIR / "index.html"
    if index_file.exists():
        return FileResponse(index_file)
    return {"status": "online"}


@app.get("/api/health")
def health():
    return {
        "status": "online",
        "app": "BuildMaster AI",
        "backend": "working",
        "ai_configured": bool(os.getenv("GEMINI_API_KEY"))
    }


@app.get("/api/info")
def info():
    return {
        "name": "BuildMaster AI",
        "purpose": "Personal AI Software Builder"
    }


@app.post("/api/chat")
def chat(data: ChatRequest):
    message = data.message.strip()

    if not message:
        return {"reply": "Please tell me your idea."}

    api_key = os.getenv("GEMINI_API_KEY")

    if not api_key:
        return {"reply": "Gemini API key is not configured in Vercel."}

    saved = ""
    if preferences:
        saved = "\n\nUser preferences:\n- " + "\n- ".join(preferences)

    prompt = (
        "You are BuildMaster AI, a helpful software architect. "
        "Help users build websites and apps step by step. "
        "Give practical plans and complete code when requested. "
        "Reply in the same language as the user. "
        "Never claim that code was deployed or tested unless it was.\n\n"
        + saved
        + "\n\nUser request:\n"
        + message
    )

    payload = json.dumps({
        "model": "gemini-3.8-flash",
        "input": prompt
    }).encode("utf-8")

    request = urllib.request.Request(
        "https://generativelanguage.googleapis.com/v1beta/interactions",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "x-goog-api-key": api_key
        },
        method="POST"
    )

    try:
        with urllib.request.urlopen(request, timeout=55) as response:
            result = json.loads(response.read().decode("utf-8"))

        reply = result.get("output_text")

        if not reply:
            parts = []
            for item in result.get("outputs", []):
                if isinstance(item, dict):
                    if item.get("text"):
                        parts.append(item["text"])
                    for part in item.get("content", []):
                        if isinstance(part, dict) and part.get("text"):
                            parts.append(part["text"])
            reply = "\n".join(parts).strip()

        return {
            "reply": reply or "No text returned. Please try again."
        }

    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        try:
            message = json.loads(detail).get("error", {}).get("message", "API request failed.")
        except Exception:
            message = "API request failed."
        return {"reply": "Gemini error: " + message}

    except Exception:
        return {"reply": "Could not connect to Gemini. Please try again."}


@app.get("/api/memory")
def get_memory():
    return {"preferences": preferences}


@app.post("/api/memory")
def save_memory(data: MemoryRequest):
    preferences.clear()

    for item in data.preferences:
        item = item.strip()
        if item and item not in preferences:
            preferences.append(item)

    return {"status": "saved", "preferences": preferences}
